server <- function(input, output, session) {
output$plot <- renderPlot({
polar_bears %>%
filter(!is.na(un_creat_ratio)) %>%
filter(!is.na(.data[[input$y]])) %>%
ggplot(aes(x = popn,
y=un_creat_ratio,
fill = .data[[input$y]]))+
geom_boxplot(alpha=0.75)+
labs(title="Range of un_creat_ratio by Population",
x="Population",
y="un_creat_ratio",
fill=input$y)+
theme_minimal()
})
}
shinyApp(ui, server)
)
