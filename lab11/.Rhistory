life_expectancy_2025 <- gapminder %>%
filter(year == 2025) %>%
drop_na(lex) %>%
arrange(desc(lex)) %>%
head(10) %>%
select(country, lex) %>%
mutate(
`lex` = round(lex, 1),
rank = row_number()
) %>%
select(rank, country, lex)
life_expectancy_2025
ggplot(data=life_expectancy_2025, aes(x=reorder(country, lex),
y=lex,
fill=lex))+
geom_bar(stat=identity, color="blue", alpha=0.8)+
ggplot(data=life_expectancy_2025, aes(x=reorder(country, lex),
y=lex,
fill=lex))+
geom_bar(stat=identity, color="blue", alpha=0.8)
ggplot(data=life_expectancy_2025, aes(x=country,
y=lex,
fill=lex))+
geom_bar(stat=identity, color="blue", alpha=0.8)
ggplot(data=life_expectancy_2025, aes(x=country,
y=lex,
fill=lex))+
geom_bar(stat=identity, color="blue", alpha=0.8)
ggplot(data=life_expectancy_2025, aes(x=country, y=lex,
fill=lex))+
geom_bar(stat=identity, color="blue", alpha=0.8)
