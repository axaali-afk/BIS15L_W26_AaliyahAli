y = "Number of Fasting Bears",
color = "Population"
) +
theme_minimal()
library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("2b7f94d1-731a-4926-8864-512d903cf6da", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
#bear_id, capture_date, popn, sex, age_class, mating, denning, lat, long, urea_nitrogen, creatinine
summary(polar_bears)
glimpse(polar_bears)
#NAs are represented by "unknown"
polar_bears<-
polar_bears %>%
mutate(mating=na_if(mating, "unknown")) %>%
mutate(denning=na_if(denning, "unknown"))
polar_bears %>%
gg_miss_var
#In the CS population, the distribution is even. In the SB population, it looks like there were more females sampled.
sex_count <- polar_bears %>%
group_by(popn, sex) %>%
summarise(count = n()) %>%
arrange(popn, sex)
ggplot(sex_count, aes(x = popn, y = count, fill = sex)) +
geom_col(alpha=0.6) +
labs(
title = "Polar Bear Sampling by Sex and Population",
x = "Population",
y = "Number of Polar Bears",
fill = "Sex"
) +
theme_minimal()
polar_bears <- polar_bears %>%
separate(capture_date, into=c("year", "month", "day"),sep="-")
polar_bears_by_year <- polar_bears %>%
group_by(year, popn) %>%
summarise(count = n()) %>%
arrange(year, popn)
ggplot(polar_bears_by_year, aes(x = year, y = count, color = popn, group = popn)) +
geom_line(linewidth = 1) +
geom_point(size = 5) +
labs(
title = "Polar Bear Sampling by Year and Population",
x = "Year",
y = "Number of Bears Sampled",
color = "Population"
) +
theme_minimal()
max(polar_bears$urea_nitrogen)
min(polar_bears$urea_nitrogen)
mean(polar_bears$urea_nitrogen)
median(polar_bears$urea_nitrogen)
max(polar_bears$creatinine)
min(polar_bears$creatinine)
mean(polar_bears$creatinine)
median(polar_bears$creatinine)
names(polar_bears)
polar_bears <- polar_bears %>%
mutate(un_creat_ratio = (urea_nitrogen * 0.466) / creatinine)
polar_bears
fasting <- (polar_bears %>%
select(un_creat_ratio) %>%
mutate(
case_when(
un_creat_ratio < 10 ~ "fasting",
un_creat_ratio == 10 ~ "fasting",
un_creat_ratio > 10 ~ "not fasting"
)
))
polar_bears <- full_join(polar_bears, fasting)
polar_bears
polar_bears <- polar_bears %>%
rename("fasting" = "case_when(...)")
polar_bears
fasting_summary <- polar_bears %>%
filter(fasting == "fasting") %>%
group_by(popn, year) %>%
summarize(n_fasting = n(), .groups = "drop")
polar_bears %>%
ggplot(aes(x = year, y = n_fasting, color = population)) +
geom_line() +
geom_point() +
labs(
title = "Number of Fasting Bears by Year",
x = "Year",
y = "Number of Fasting Bears",
color = "Population"
) +
theme_minimal()
polar_bears %>%
ggplot(polar_bears, aes(x = year, y = fasting_summary$n_fasting, color = popn)) +
geom_line(size = 1) +
geom_point() +
labs(title = "Number of Fasting Bears by Year",
x = "Year",
y = "Number of Fasting Bears",
color = "Population") +
theme_minimal()
polar_bears %>%
ggplot(aes(x = year, y = fasting_summary$n_fasting, color = popn)) +
geom_line(size = 1) +
geom_point() +
labs(title = "Number of Fasting Bears by Year",
x = "Year",
y = "Number of Fasting Bears",
color = "Population") +
theme_minimal()
polar_bears %>%
ggplot(aes(x = year, y = fasting, color = popn)) +
geom_line(size = 1) +
geom_point() +
labs(title = "Number of Fasting Bears by Year",
