separate(capture_date, into=c("year", "month", "day"),sep="-")
polar_bears_by_year <- polar_bears %>%
group_by(year, popn) %>%
summarise(count = n()) %>%
arrange(year, popn)
ggplot(polar_bears_by_year, aes(x = year, y = count, color = popn, group = popn)) +
geom_line(linewidth = 1) +
geom_point(size = 5) +
labs(
title = "Polar Bear Sampling by Year and Population",
x = "Year",
y = "Number of Bears Sampled",
color = "Population"
) +
theme_minimal()
max(polar_bears$urea_nitrogen)
min(polar_bears$urea_nitrogen)
mean(polar_bears$urea_nitrogen)
median(polar_bears$urea_nitrogen)
max(polar_bears$creatinine)
min(polar_bears$creatinine)
mean(polar_bears$creatinine)
median(polar_bears$creatinine)
names(polar_bears)
un_creat_ratio <- (polar_bears$urea_nitrogen*0.466)/polar_bears$creatinine
bear_id <- polar_bears$bear_id
year <- polar_bears$year
month <- polar_bears$month
day <- polar_bears$day
popn <- polar_bears$popn
sex <- polar_bears$sex
age_class <- polar_bears$age_class
mating <- polar_bears$mating
denning <- polar_bears$denning
lat <- polar_bears$lat
long <- polar_bears$long
urea_nitrogen <- polar_bears$urea_nitrogen
creatinine <- polar_bears$creatinine
polar_bears <- tibble(bear_id,    year, month,  day,  popn, sex, age_class, mating, denning, long, urea_nitrogen, creatinine, un_creat_ratio)
polar_bears
fasting <- (polar_bears %>%
select(un_creat_ratio) %>%
mutate(
case_when(
un_creat_ratio < 10 ~ "fasting",
un_creat_ratio == 10 ~ "fasting",
un_creat_ratio > 10 ~ "not fasting"
)
))
polar_bears <- full_join(polar_bears, fasting)
polar_bears
polar_bears <- polar_bears %>%
rename("fasting" = "case_when(...)")
polar_bears
