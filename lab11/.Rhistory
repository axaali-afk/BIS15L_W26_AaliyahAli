top_5_countries <- gapminder %>%
filter(year %in% c(1975, 2025)) %>%
filter(country != "Monaco") %>%
drop_na(gdp) %>%
pivot_wider(
names_from = year,
values_from = gdp,
names_prefix = "gdp_"
) %>%
mutate(absolute_growth = gdp_2025 - gdp_1975) %>%
arrange(desc(absolute_growth)) %>%
head(5) %>%
pull(country)
gdp_growth_plot_data <- gapminder %>%
filter(country %in% top_5_countries) %>%
filter(year >= 1975) %>%
drop_na(gdp)
ggplot(gdp_growth_plot_data, aes(x = year, y = gdp, color = country, group = country)) +
geom_line(size = 1.2) +
geom_point(size = 2) +
labs(
title = "GDP Per Capita Growth Over Time: Top 5 Countries (1975-2025)",
subtitle = "Countries with highest absolute GDP per capita growth",
x = "Year",
y = "GDP Per Capita ($USD)",
color = "Country")
life_expectancy_2025 <- gapminder %>%
filter(year == 2025) %>%
drop_na(lex) %>%
arrange(desc(lex)) %>%
head(10) %>%
select(country, lex) %>%
rename(
Country = country,
`Life Expectancy (years)` = lex
) %>%
mutate(
`Life Expectancy (years)` = round(`Life Expectancy (years)`, 1),
Rank = row_number()
) %>%
select(Rank, Country, `Life Expectancy (years)`)
life_expectancy_2025 <- gapminder %>%
