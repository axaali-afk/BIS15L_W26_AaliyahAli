library(shiny)
ui <- fluidPage(
theme=shinythemes::shinytheme("cosmo"),
selectInput("y",
"Select Polar Bear Variable",
choices = c("sex",
"mating",
"age_class",
"denning",
"fasting"),
selected = "sex"),
plotOutput("plot", width="600px", height= "500px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
polar_bears %>%
filter(un_creat_ratio!="NA") %>%
ggplot(aes(x = popn,
y=un_creat_ratio,
fill = .data[[input$y]]))+
geom_boxplot(alpha=0.75)+
labs(title="Range of un_creat_ratio by Population",
x="Population",
y="un_creat_ratio"
fill=popn)+
