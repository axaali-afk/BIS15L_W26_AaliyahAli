knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
options(scipen = 999)
gapminder <- read_csv("data/gapminder.csv") %>%
clean_names() %>%
filter(between(year, 1925, 2025))
glimpse(gapminder)
num_countries <- length(unique(gapminder$country))
num_countries
population_growth <- gapminder %>%
filter(year %in% c(1925, 2025)) %>%
pivot_wider(
names_from = year,
values_from = pop
) %>%
mutate(
growth_1925_2025 = `2025` - `1925`,
growth_1925_2025 = replace_na(growth_1925_2025, 0)
) %>%
arrange(desc(growth_1925_2025)) %>%
head(5) %>%
select(country, `1925`, `2025`, growth_1925_2025)
population_growth
top_country <- gapminder %>%
filter(year %in% c(1925,2025)) %>%
pivot_wider(
names_from=year,
values_from=pop) %>%
mutate(growth=`2025`-`1925`) %>%
arrange(desc(growth)) %>%
slice(1) %>%
pull(country)
#ggplot(top_country, aes(x = year, y = pop)) +
#  geom_line(size = 1.2, color = "steelblue") +
#  geom_point(size = 3, color = "steelblue") +
# labs(
#  title = paste("Population Growth Over Time:", top_country),
#  subtitle = "1925 - 2025",
#  x = "Year",
# y = "Population")
gapminder %>%
group_by(year) %>%
summarise(minimum=min(lex, na.rm=T),
median=mean(lex, na.rm=T),
mean=mean(lex, na.rm=T),
maximum=max(lex, na.rm=T))
life_expectancy_distribution <- gapminder %>%
filter(year %in% c(1925, 2025))%>%
drop_na(lex)
ggplot(data=life_expectancy_distribution, aes(x=lex, fill=as.factor(year),alpha=0.6))+
geom_density(position="identity")+
labs(title="Distribution of Life Expectancy by Country: 1925 to 2025",
x="Life Expectancy (years)",
y="Density",
fill="Year")
#Overall, the life expectancy increased over time
gdp_lex_2025 <- gapminder %>%
filter(year==2025) %>%
filter(country !="Monaco") %>%
drop_na(gdp, lex)
ggplot(data=gdp_lex_2025, aes(x=gdp, y=lex))+
geom_point(size=3, alpha=0.6, color="red")+
geom_smooth(method="lm", se=T, color="purple", alpha=0.2)+
labs(title="Relationship Between GDP Per Capita and Life Expectancy (2025)",
x="GDP Per Capita (USD)",
y="Life Expectancy (years)")
gdp_growth_50yr <- gapminder %>%
filter(year %in% c(1975,2025)) %>%
filter(country != "Monaco") %>%
drop_na(gdp) %>%
pivot_wider(
names_from = year,
values_from = gdp,
names_prefix = "gdp_") %>%
mutate(absolute_growth= gdp_2025 - gdp_1975) %>%
arrange(desc(absolute_growth)) %>%
head(5) %>%
select(country, gdp_1975, gdp_2025,absolute_growth) %>%
rename(Country=country,
'gdp per capita 1975 ($)'=gdp_1975,
'gdp per capita 2025($)'=gdp_2025,
'absolute growth ($)'=absolute_growth) %>%
mutate(across(where(is.numeric), ~round(.,2)))
gdp_growth_50yr
top_5_countries <- gapminder %>%
filter(year %in% c(1975, 2025)) %>%
filter(country != "Monaco") %>%
drop_na(gdp) %>%
pivot_wider(
names_from = year,
values_from = gdp,
names_prefix = "gdp_"
) %>%
mutate(absolute_growth = gdp_2025 - gdp_1975) %>%
arrange(desc(absolute_growth)) %>%
head(5) %>%
pull(country)
gdp_growth_plot_data <- gapminder %>%
filter(country %in% top_5_countries) %>%
filter(year >= 1975) %>%
drop_na(gdp)
ggplot(gdp_growth_plot_data, aes(x = year, y = gdp, color = country, group = country)) +
geom_line(size = 1.2) +
geom_point(size = 2) +
labs(
title = "GDP Per Capita Growth Over Time: Top 5 Countries (1975-2025)",
subtitle = "Countries with highest absolute GDP per capita growth",
x = "Year",
y = "GDP Per Capita ($USD)",
color = "Country")
life_expectancy_2025 <- gapminder %>%
filter(year == 2025) %>%
drop_na(lex) %>%
arrange(desc(lex)) %>%
head(10) %>%
select(country, lex) %>%
rename(
Country = country,
`Life Expectancy (years)` = lex
) %>%
mutate(
`Life Expectancy (years)` = round(`Life Expectancy (years)`, 1),
Rank = row_number()
) %>%
select(Rank, Country, `Life Expectancy (years)`)
life_expectancy_2025
life_expectancy_2025 <- gapminder %>%
filter(year == 2025) %>%
drop_na(lex) %>%
arrange(desc(lex)) %>%
head(10) %>%
select(country, lex) %>%
mutate(
`Life Expectancy (years)` = round(`Life Expectancy (years)`, 1),
Rank = row_number()
) %>%
select(Rank, Country, `Life Expectancy (years)`)
